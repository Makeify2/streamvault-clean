# Copy this file to .env.production (or .env.local for development) and set your own API base.
#
# The frontend reads VITE_API_BASE at build time — it is the public URL of your StreamVault
# backend (the service that serves /api routes). Point it at your own deployment, not someone
# else's server.
#
# Example:
#   VITE_API_BASE=https://api.your-domain.example
VITE_API_BASE=
