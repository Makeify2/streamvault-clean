PORT=5000

# --- Secrets -----------------------------------------------------------------
# Generate with: openssl rand -hex 32
# Required when NODE_ENV=production. The server refuses to start with a placeholder or a
# secret shorter than 32 characters, and it no longer falls back to a built-in default.
JWT_SECRET=

# Set a password, or "none" to disable authentication entirely. With "none" you must also
# set ALLOW_NO_AUTH=1 in production: it acknowledges that every API route, including the
# stream proxy, is reachable by anyone who can reach this host.
APP_PASSWORD=
# ALLOW_NO_AUTH=1

# --- Upstream API keys -------------------------------------------------------
TORBOX_API_KEY=your_torbox_api_key_here
TMDB_API_KEY=your_tmdb_api_key_here

# OpenSubtitles (required for subtitle search)
OPENSUBTITLES_API_KEY=your_opensubtitles_api_key_here
# Optional: login for higher download quota (5/day free vs 100+/day with account)
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# --- Web deployment ----------------------------------------------------------
# Comma-separated origins allowed to make cross-origin requests. Leave empty to serve no
# CORS headers at all, which is correct when the frontend is served from the same host.
ALLOWED_ORIGIN=

# Shared secret for the GitHub webhook. The webhook process REFUSES TO START without it:
# an unverified webhook lets anyone who can reach the port trigger a deploy.
WEBHOOK_SECRET=
WEBHOOK_PORT=9000
# Branch the deploy webhook reacts to (default: main)
DEPLOY_BRANCH=main
# Checkout the webhook deploys (default: /opt/streamvault)
REPO_DIR=/opt/streamvault

# --- Streaming ---------------------------------------------------------------
# Optional proxy for streaming-server requests (sudo-proxy or a CF Worker).
# Leave empty to hit streaming sites directly (usually blocked without a proxy).
STREAM_PROXY=

# Optional. Empty = allow any public host through /api/proxy. Private, loopback,
# link-local and cloud-metadata addresses are always blocked at connect time, including
# on redirect hops. Set a comma-separated list to pin the proxy to known hosts.
PROXY_ALLOWED_HOSTS=

# Optional cap on bytes buffered when rewriting an m3u8 playlist (default 8 MiB)
# PROXY_MAX_BYTES=8388608

# Max concurrent ffmpeg encode processes before new stream requests are refused (default 8)
MAX_FFMPEG_PROCS=8

# Local media library directory (default /root/streamvault-local)
LOCAL_MEDIA_DIR=/root/streamvault-local

# HLS segment cache directory (default /tmp/sv-cache)
HLS_CACHE_DIR=/tmp/sv-cache

# --- Multi-source scraping ---
# Enable/disable individual scrape sources. Default: all enabled.
# Set to 0 to disable, e.g. SOURCE_TGX=0
SOURCE_VIDSRC=1
SOURCE_2EMBED=1
SOURCE_SUPEREMBED=1
SOURCE_VIDLINK=1
SOURCE_VIDKING=1
SOURCE_TORBOX=1
SOURCE_YTS=1
SOURCE_1337X=1
SOURCE_TGX=1

# --- Debugging ---------------------------------------------------------------
# 1 = include the underlying error message in API error responses.
# Leave unset in production: error text can disclose paths, hosts and query details.
# DEBUG_ERRORS=1
